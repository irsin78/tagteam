{
  "_comment": "Copy as model-bindings.local.json. Dictionaries merge; arrays/scalars replace. Omit unused overrides to keep public defaults. Project domain policy goes in root CLAUDE.md/AGENTS.md.",
  "schema_version": 3,
  "budget_comment": "Optional budget string: normal, tight, exhausted:<vendor>. Omit budget for normal. Startup never probes quota; declare changes when needed.",
  "subscriptions": {
    "claude": null,
    "openai": null,
    "google": null
  },
  "vendors": {
    "local": {
      "endpoint": null
    }
  },
  "local_endpoint_comment": "When used, set vendors.local.endpoint to {\"base_url\": \"http://localhost:1234/v1\", \"model\": \"auto\", \"wire\": \"chat\"}; base_url/model required. auto selects the single loaded non-embedding model. Confirm the project data boundary before sending content.",
  "roles": {},
  "time_cost_comment": "Optional time override: attended waits are convex through switch_after_min, then pay refocus plus a linear slope; background (already switched) and unattended (away) are linear. Numeric mode values retain legacy convex cost. The session declaration (harness-session.py time) is the normal way to change state and overrides these defaults; router --time-* flags override the session.",
  "selection_policy": {
    "time_cost": {
      "tolerance_min": 30,
      "switch_after_min": 3,
      "default_mode": "attended",
      "modes": {
        "attended": {"k": 5, "refocus_usd": 5, "slope_usd_per_tolerance": 1.5},
        "background": {"k": 0, "refocus_usd": 0, "slope_usd_per_tolerance": 1.5},
        "unattended": {"k": 0, "refocus_usd": 0, "slope_usd_per_tolerance": 0.25}
      }
    }
  },
  "override_comment": "workers_local recursively merges an existing id or appends a new worker. A workers array replaces the entire public list. Do not put empty specialties here: arrays replace the public list.",
  "measurements": [],
  "measurements_comment": "Only relevant observations for repeated mismatches: role/model, elapsed time, verify result, retries, date. No obligatory scoring or telemetry campaign.",
  "workers_local": [
    {
      "id": "sol61-high",
      "effort": "high"
    },
    {
      "id": "project-reader",
      "vendor": "local",
      "model": "auto",
      "effort": null,
      "tier": "D",
      "launcher": ".claude/scripts/local-run.sh",
      "roles": {
        "explore": 3
      },
      "status": "optional",
      "requires": {
        "local_endpoint": true
      },
      "scored": false
    }
  ],
  "personal_judgement_comment": "Keep personal judgement here: for example, set trust: low in a workers_local row or override selection_policy.assessment for project needs."
}
