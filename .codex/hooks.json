{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session_preflight.py",
            "timeout": 30,
            "statusMessage": "harness preflight"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|exec_command|shell_command|apply_patch|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/deny_dangerous.py --host codex",
            "timeout": 30,
            "statusMessage": "harness guard"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/stop_gate.py --host codex --new-prompt",
            "timeout": 10,
            "statusMessage": "harness mission scope"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/stop_gate.py --host codex",
            "timeout": 180,
            "statusMessage": "harness stop gate"
          }
        ]
      }
    ]
  }
}
