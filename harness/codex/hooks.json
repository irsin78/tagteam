{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/tagteam/role_guard.py SessionStart --host codex",
            "timeout": 10,
            "statusMessage": "tagteam role guard",
            "commandWindows": "python .claude/tagteam/role_guard.py SessionStart --host codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/tagteam/role_guard.py UserPromptSubmit --host codex",
            "timeout": 10,
            "statusMessage": "tagteam role guard",
            "commandWindows": "python .claude/tagteam/role_guard.py UserPromptSubmit --host codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|shell|exec_command|shell_command|local_shell|mcp__ccd_session__start_session|Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/tagteam/role_guard.py PreToolUse --host codex",
            "timeout": 10,
            "statusMessage": "tagteam role guard",
            "commandWindows": "python .claude/tagteam/role_guard.py PreToolUse --host codex"
          }
        ]
      }
    ]
  }
}
