{
  "_comment": "Per-machine settings, created by install.py and never committed. plans.<vendor>: none|free|pro|max (missing = pro; none removes the vendor, free moves it last in the default order), e.g. {\"google\": \"free\"}. models.<id>.enabled: false hides a model, true skips the availability check. available: filled by models_collect.py --write-available (install runs it) with the ids each vendor CLI really offers; a vendor with no entry is assumed to offer everything. roles.<role> may set model, effort, vendor and grade.",
  "plans": {},
  "models": {},
  "roles": {}
}
